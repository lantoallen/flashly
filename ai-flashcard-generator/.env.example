# Copy to .env.local for local development. Never commit real keys.

# --- AI providers (at least one is required for AI features) ----------------
# Providers are tried in this order and Flashly fails over automatically, so
# adding a second free key makes generation much more reliable.
GROQ_API_KEY=
# CEREBRAS_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Optional: change the order or the models (comma separated).
# AI_PROVIDER_ORDER=groq,cerebras,gemini,openrouter
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# --- Accounts (optional) -------------------------------------------------------
# Create a free project at supabase.com, run supabase/schema.sql, then:
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Enables the "Delete my account" button and report alerts.
# Never expose this key (no NEXT_PUBLIC_ prefix).
# SUPABASE_SERVICE_ROLE_KEY=
# Optional: only accept the daily keep-alive cron's calls (Vercel sends it).
# CRON_SECRET=

# --- Shared rate limiting (optional, recommended in production) --------------
# A free Upstash Redis database (upstash.com) lets every server instance share
# one request count per visitor. Without it, each instance counts separately.
# UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# --- Report alerts (optional, recommended once the community is public) -----
# Emails you whenever someone reports a set, a person or a message. Needs
# SUPABASE_SERVICE_ROLE_KEY above and a free Resend key (resend.com). Resend's
# shared sender can only email the address you signed up with, so use that
# here, or verify your own domain and set REPORT_ALERT_FROM.
# RESEND_API_KEY=
# REPORT_ALERT_EMAIL=you@example.com
# REPORT_ALERT_FROM=Flashly <alerts@your-domain.com>
